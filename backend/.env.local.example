# Docker'siz (desktop) rejim uchun namuna.
# Installer bu fayl asosida backend/.env yaratadi va yo'llarni to'ldiradi.
APP_NAME=VideoWorkflow Studio
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=local-change-me
API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","*"]

# SQLite — Postgres kerak emas. Installer bu qatorni mutlaq yo'l bilan yangilaydi.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
REDIS_URL=
LOCAL_MODE=true
WORKER_JOB_TIMEOUT=14400

# Installer STORAGE_DIRni mutlaq yo'l bilan yangilaydi.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_SEC=600

# Video tahlili uchun OpenRouter kaliti (batch uchun shart emas).
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.0-flash-exp:free
AI_FALLBACK_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
AI_TIMEOUT=1800
AI_MAX_TOKENS=600
AI_TEMPERATURE=0.0

FRAME_RATE=1
DIFF_THRESHOLD=0.04
MAX_FRAMES=2000
BETWEEN_FRAMES_DELAY=2
USE_OCR=true

# Brauzer: chromium, chrome, msedge, firefox yoki webkit.
# Har bir run uchun brauzerni sayt interfeysidan ham tanlash mumkin.
# BROWSER_CHANNEL faqat tizimda o'rnatilgan Chrome/Edge ishlatilsa to'ldiriladi.
BROWSER_TYPE=chromium
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0
BROWSER_CHANNEL=
BROWSER_EXECUTABLE=
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
