# Brauzer so'rovlarini Next.js orqali backend'ga yuborish (tavsiya etiladi).
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://127.0.0.1:8000

# Ixtiyoriy. Faqat production'da backend API_KEY talab qilsa to'ldiriladi.
NEXT_PUBLIC_API_KEY=

# Ixtiyoriy. Bo'sh qoldirilsa, WebSocket joriy hostname va 8000-portdan olinadi.
# HTTPS/reverse proxy ishlatilsa, masalan: wss://example.com/api/ws
NEXT_PUBLIC_WS=
